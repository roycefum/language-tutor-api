# Copy to .env for local development. In production (Railway/Render/etc.),
# set these as environment variables in the host's dashboard instead —
# never commit a real .env file (see project_langreps_security memory note
# on why this matters for this project specifically).

# Supabase project URL and anon key (Settings -> API in the Supabase dashboard).
# This backend only ever uses the anon key, never the service-role key.
SUPABASE_URL=
SUPABASE_KEY=

# Google Gemini API key (https://aistudio.google.com/apikey). Picked up
# automatically by the google-genai SDK's genai.Client() — no need to pass
# it explicitly anywhere in code.
GEMINI_API_KEY=
